# MongoDB Configuration (Atlas M0 Replica Set)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=jam_note

# Aiven Kafka Configuration (SASL/SCRAM-SHA-512 + TLS)
KAFKA_BROKERS=kafka-jam-note-<project>.aivencloud.com:port
KAFKA_TOPIC=jam-note.note-events.v1
KAFKA_USER=avnadmin
KAFKA_PASSWORD=<secret>
KAFKA_CA_CERT=ca.pem

# Outbox & Tuning Defaults
LEASE_DURATION=60s
RECONCILE_INTERVAL=2m
BATCH_LIMIT=100
MAX_PUBLISH_RETRIES=3
DRAIN_TIMEOUT=15s

# Heartbeat Interval
HEARTBEAT_INTERVAL=6h
