# MongoDB Configuration (Atlas M0 Replica Set or local mongod)
# Aliases: MONGODB_URL or MONGODB_URI (MONGODB_URL takes precedence)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=jam_note

# Aiven Kafka Configuration (SASL/SCRAM-SHA-512 + TLS)
# Aliases: KAFKA_USER or KAFKA_USERNAME
KAFKA_BROKERS=kafka-jam-note-<project>.aivencloud.com:port
KAFKA_TOPIC=jam-note.note-events.v1
KAFKA_GROUP_ID=jam-note-search-indexer
KAFKA_USER=avnadmin
KAFKA_PASSWORD=<secret>
# Path to CA cert file, or inline PEM data. Relative to CWD or parent directory.
KAFKA_CA_CERT=ca.pem

# Aiven OpenSearch Configuration (HTTPS + Basic Auth)
# OPENSEARCH_URL can embed credentials: https://user:pass@host:port
# Or set OPENSEARCH_USER / OPENSEARCH_USERNAME + OPENSEARCH_PASSWORD separately.
# Aliases: OPENSEARCH_URL or OPENSEARCH_URI; OPENSEARCH_USER or OPENSEARCH_USERNAME
OPENSEARCH_URL=https://<user>:<password>@opensearch-jam-note-<project>.aivencloud.com:port
OPENSEARCH_USER=avnadmin
OPENSEARCH_PASSWORD=<secret>
OPENSEARCH_INDEX=notes-blocks-v1
OPENSEARCH_ALIAS=notes-blocks

# Worker & Fault Tolerance Tuning (optional — these are the defaults)
DRAIN_TIMEOUT=15s
RETRY_INITIAL_INTERVAL=500ms
RETRY_MAX_INTERVAL=30s
