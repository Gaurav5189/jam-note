MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="jam_note"
JWT_SECRET="super-secret-dev-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="10080" # 7 days
COOKIE_NAME="jam_session"
CORS_ORIGINS='["http://localhost:3000"]'

# OpenSearch / magic search (phase 8.2)
# For Aiven, paste the full "Service URI" here — it already embeds user:pass@host:port
OPENSEARCH_URL="http://localhost:9200"
OPENSEARCH_USER=""           # leave blank if credentials are embedded in OPENSEARCH_URL
OPENSEARCH_PASSWORD=""       # leave blank if credentials are embedded in OPENSEARCH_URL
OPENSEARCH_INDEX="notes-blocks-v1"   # physical index name
OPENSEARCH_ALIAS="notes-blocks"      # alias used by the search API and reindex script
OPENSEARCH_TIMEOUT="5.0"             # seconds; set higher if Aiven free tier is slow to respond
