MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="jam_note"
# ── Auth mode ──────────────────────────────────────────────────────────
# "legacy"     = FastAPI issues/verifies the jam_session cookie JWT.
# "betterauth" = Next.js/BetterAuth owns auth; FastAPI only accepts a
#                BetterAuth Bearer JWT verified against the JWKS below.
# Keep "legacy" until the frontend cutover, then flip and redeploy.
AUTH_MODE="legacy"
BETTER_AUTH_JWKS_URL="http://localhost:3000/api/auth/jwks"
BETTER_AUTH_ISSUER="http://localhost:3000"
BETTER_AUTH_AUDIENCE="http://localhost:3000"
# Pinned signing algorithm — BetterAuth's JWT plugin defaults to EdDSA.
BETTER_AUTH_JWT_ALGORITHM="EdDSA"
BETTER_AUTH_JWKS_CACHE_SECONDS="300"
BETTER_AUTH_JWKS_TIMEOUT_SECONDS="10"
BETTER_AUTH_CLOCK_SKEW_SECONDS="10"

# REQUIRED in legacy mode: Generate with `openssl rand -hex 32` (32 bytes = 64 hex chars)
JWT_SECRET=""
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="10080" # 7 days
COOKIE_NAME="jam_session"
CORS_ORIGINS='["http://localhost:3000"]'
# Set to "production" to enable Secure cookie flag, HSTS, and CSP
ENVIRONMENT="development"

# OpenSearch / magic search (phase 8.2)
# For Aiven, paste the full "Service URI" here — it already embeds user:pass@host:port
OPENSEARCH_URL="http://localhost:9200"
OPENSEARCH_USER=""           # leave blank if credentials are embedded in OPENSEARCH_URL
OPENSEARCH_PASSWORD=""       # leave blank if credentials are embedded in OPENSEARCH_URL
OPENSEARCH_INDEX="notes-blocks-v1"   # physical index name
OPENSEARCH_ALIAS="notes-blocks"      # alias used by the search API and reindex script
OPENSEARCH_TIMEOUT="5.0"             # seconds; set higher if Aiven free tier is slow to respond
