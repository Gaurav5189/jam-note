# Public FastAPI origin used by Next.js Server Components and API rewrites.
# Do not include a trailing slash or the /api path.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Public site origin used for sitemap, robots, and OpenGraph URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── BetterAuth ─────────────────────────────────────────────────────────
# BetterAuth owns /api/auth/* in this Next.js app and writes its auth
# collections (user, session, account, verification, jwks) to the same
# MongoDB database FastAPI uses.
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="jam_note"
# REQUIRED in production. Generate with `openssl rand -hex 32`.
# Never commit a real secret.
BETTER_AUTH_SECRET=""
# Public origin of this Next.js app (no trailing slash, no /api).
BETTER_AUTH_URL="http://localhost:3000"
# Enable only when MongoDB runs as a replica set (Atlas does). Local
# standalone MongoDB rejects transactions.
MONGODB_TRANSACTIONS="false"

# Search-engine verification codes (SEO meta tags render only when set).
# Google Search Console: HTML tag verification content value.
NEXT_PUBLIC_GSC_VERIFICATION=""
# Bing Webmaster: the "msvalidate.01" content value.
NEXT_PUBLIC_BING_VERIFICATION=""
