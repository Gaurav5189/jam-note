# Public FastAPI origin used by Next.js Server Components and API rewrites.
# Do not include a trailing slash or the /api path.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Public site origin used for sitemap, robots, and OpenGraph URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Search-engine verification codes (SEO meta tags render only when set).
# Google Search Console: HTML tag verification content value.
NEXT_PUBLIC_GSC_VERIFICATION=""
# Bing Webmaster: the "msvalidate.01" content value.
NEXT_PUBLIC_BING_VERIFICATION=""